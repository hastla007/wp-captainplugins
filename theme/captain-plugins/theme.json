{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1160px"
    },
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "Tiefblau", "color": "#102D43" },
        { "slug": "navy", "name": "Captain Navy", "color": "#12394F" },
        { "slug": "blue-soft", "name": "Helles Blau", "color": "#EAF4FA" },
        { "slug": "gold", "name": "Captain Gold", "color": "#E2AE45" },
        { "slug": "paper", "name": "Weiß", "color": "#FFFFFF" },
        { "slug": "surface", "name": "Helle Fläche", "color": "#F4F8FA" },
        { "slug": "muted", "name": "Sekundärtext", "color": "#526779" },
        { "slug": "border", "name": "Rahmen", "color": "#D7E2EA" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "0.5rem" },
        { "slug": "30", "name": "S", "size": "0.75rem" },
        { "slug": "40", "name": "M", "size": "1rem" },
        { "slug": "50", "name": "L", "size": "1.5rem" },
        { "slug": "60", "name": "XL", "size": "2rem" },
        { "slug": "70", "name": "2XL", "size": "3rem" },
        { "slug": "80", "name": "3XL", "size": "4.5rem" }
      ],
      "units": [ "%", "px", "rem", "vh", "vw" ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif", "slug": "system", "name": "System Sans" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Klein", "size": "0.9rem" },
        { "slug": "medium", "name": "Normal", "size": "1.125rem" },
        { "slug": "large", "name": "Groß", "size": "clamp(1.4rem, 2vw, 2rem)" },
        { "slug": "x-large", "name": "Sehr groß", "size": "clamp(2.4rem, 5vw, 4.5rem)" }
      ]
    },
    "blocks": {
      "core/button": { "border": { "radius": true }, "spacing": { "padding": true } },
      "core/image": { "border": { "radius": true } }
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|paper", "text": "var:preset|color|ink" },
    "spacing": { "blockGap": "1.5rem" },
    "typography": { "fontFamily": "var:preset|font-family|system", "fontSize": "1.0625rem", "lineHeight": "1.65" },
    "elements": {
      "heading": { "color": { "text": "var:preset|color|ink" }, "typography": { "fontWeight": "700", "lineHeight": "1.15" } },
      "link": { "color": { "text": "var:preset|color|navy" }, "typography": { "textDecoration": "underline" } },
      "button": { "border": { "radius": "0.4rem" }, "color": { "background": "var:preset|color|navy", "text": "var:preset|color|paper" }, "typography": { "fontSize": "1rem", "fontWeight": "650" }, "spacing": { "padding": { "top": "0.8rem", "right": "1.2rem", "bottom": "0.8rem", "left": "1.2rem" } } }
    },
    "blocks": {
      "core/group": { "spacing": { "blockGap": "1.5rem" } },
      "core/site-title": { "typography": { "fontSize": "1.2rem", "fontWeight": "750", "letterSpacing": "-0.02em" } },
      "core/navigation": { "typography": { "fontSize": "0.95rem", "fontWeight": "600" } },
      "core/separator": { "color": { "background": "var:preset|color|border" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-wide", "title": "Breite Inhaltsseite", "postTypes": [ "page" ] },
    { "name": "page-product", "title": "Produktseite", "postTypes": [ "page" ] },
    { "name": "page-pricing", "title": "Preisübersicht", "postTypes": [ "page" ] },
    { "name": "page-resource", "title": "Ressourcen- und Dokumentationsseite", "postTypes": [ "page" ] }
  ]
}
