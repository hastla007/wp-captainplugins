msgstr "No plugins selected, or all selected plugins are already active."

#: inc/setup.php:290 inc/setup.php:304 inc/setup.php:439
msgid "Keine Berechtigung."
msgstr "Permission denied."

#. translators: 1: created, 2: updated, 3: unchanged, 4: kept because edited, 5: protected by placeholders, 6: errors, 7: retired pages.
#: inc/setup.php:311
msgid "Seitenabgleich: %1$d neu angelegt, %2$d aktualisiert, %3$d unverändert, %4$d wegen eigener Änderungen geschont, %5$d mit Platzhaltern geschützt, %6$d Fehler, %7$d nicht mehr gelieferte Seiten auf Entwurf gesetzt."
msgstr "Page sync: %1$d created, %2$d updated, %3$d unchanged, %4$d kept because of your edits, %5$d protected because of placeholders, %6$d errors, %7$d retired pages moved to draft."

#: inc/setup.php:322
msgid "Keine Berechtigung zum Verwalten von WooCommerce-Produkten."
msgstr "You are not allowed to manage WooCommerce products."

#. translators: 1: created, 2: license plans mapped, 3: already set up, 4: skipped, 5: errors.
#: inc/setup.php:328
msgid "Produktentwürfe: %1$d angelegt, %2$d Lizenzpläne verknüpft, %3$d bereits eingerichtet, %4$d übersprungen, %5$d Fehler."
msgstr "Product drafts: %1$d created, %2$d license plans mapped, %3$d already set up, %4$d skipped, %5$d errors."

