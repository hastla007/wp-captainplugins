{
  "name": "hastla007/wp-captainplugins",
  "description": "Website-Texte und Block-Theme der Captain Plugins; Composer nur für Entwicklerwerkzeuge (PHPCS).",
  "type": "project",
  "license": "proprietary",
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  }
}
